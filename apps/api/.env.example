APP_ENV=development
APP_VERSION=0.1.0
GIT_COMMIT=local
DEPLOYED_AT=
SECRET_KEY=replace-with-a-random-local-value
DATABASE_URL=postgresql+psycopg://movimento7:movimento7-local@127.0.0.1:54327/movimento7
PUBLIC_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
SESSION_COOKIE_SECURE=false
EMAIL_DELIVERY_MODE=log
EMAIL_SANDBOX_RECIPIENT=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Movimento 7
EMAIL_REPLY_TO=
EMAIL_CONTACT_RECIPIENT=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
PASSWORD_RESET_MINUTES=30
INITIAL_ADMIN_EMAIL=admin@movimento7.com
INITIAL_ADMIN_NAME=Administrador Movimento 7
INITIAL_ADMIN_PASSWORD=
AUCTION_BIDDING_ENABLED=false
PAYMENT_PROVIDER=manual
MEDIA_PROVIDER=local
# Em produção: google_drive após concluir o OAuth no painel.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/v1/admin/integrations/google-drive/callback
# Gere uma chave Fernet; nunca reutilize SECRET_KEY.
MEDIA_TOKEN_ENCRYPTION_KEY=
MEDIA_LOCAL_ROOT=./uploads
MEDIA_PUBLIC_BASE_URL=http://localhost:5000/media
# Pasta exclusiva para imagens de produtos. Deixe vazio no modo local.
GOOGLE_DRIVE_PRODUCT_FOLDER_ID=
# Pasta raiz exclusiva para imagens da galeria; não reutilize a pasta de produtos.
GOOGLE_DRIVE_GALLERY_FOLDER_ID=
ERROR_REPORTING_DSN=
MAX_UPLOAD_MB=10
ORDER_RESERVATION_MINUTES=30
SHIPPING_METHOD=manual
SHIPPING_LABEL=Entrega padrão
SHIPPING_FLAT_RATE_CENTS=0
SHIPPING_FREE_THRESHOLD_CENTS=0
SHIPPING_ESTIMATED_DAYS=0
